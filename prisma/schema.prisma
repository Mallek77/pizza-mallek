// Prisma schema for Mc Mallek pizzeria (Draâ Ben Khedda, Tizi Ouzou, Algérie)
// PostgreSQL · French / Arabic bilingual (name_fr / name_ar)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum OrderType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum Locale {
  fr @map("fr")
  ar @map("ar")
}

// ──────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────

model Category {
  id            String   @id @default(uuid()) @db.Uuid
  name_fr       String   @db.VarChar(100)
  name_ar       String   @db.VarChar(100)
  slug          String   @unique @db.VarChar(100)
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  products      Product[]

  @@index([is_active, display_order])
  @@map("categories")
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  category       Category         @relation(fields: [category_id], references: [id])
  category_id    String           @db.Uuid
  name_fr        String           @db.VarChar(150)
  name_ar        String           @db.VarChar(150)
  description_fr String?          @db.Text
  description_ar String?          @db.Text
  base_price     Decimal          @db.Decimal(10, 2)
  image_url      String?          @db.VarChar(255)
  is_available   Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(3)
  updated_at     DateTime         @updatedAt @db.Timestamptz(3)
  variants       ProductVariant[]
  optionGroups   OptionGroup[]

  @@index([category_id])
  @@index([is_available])
  @@index([category_id, is_available])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  product        Product  @relation(fields: [product_id], references: [id])
  product_id     String   @db.Uuid
  name_fr        String   @db.VarChar(100)
  name_ar        String   @db.VarChar(100)
  price_override Decimal? @db.Decimal(10, 2)

  @@index([product_id])
  @@map("product_variants")
}

model OptionGroup {
  id             String         @id @default(uuid()) @db.Uuid
  product        Product        @relation(fields: [product_id], references: [id])
  product_id     String         @db.Uuid
  name_fr        String         @db.VarChar(100)
  name_ar        String         @db.VarChar(100)
  is_required    Boolean        @default(false)
  max_selections Int            @default(1)
  optionValues   OptionValue[]

  @@index([product_id])
  @@index([is_required])
  @@map("option_groups")
}

model OptionValue {
  id               String      @id @default(uuid()) @db.Uuid
  optionGroup      OptionGroup @relation(fields: [option_group_id], references: [id])
  option_group_id  String      @db.Uuid
  name_fr          String      @db.VarChar(100)
  name_ar          String      @db.VarChar(100)
  price_supplement Decimal     @default(0) @db.Decimal(10, 2)

  @@index([option_group_id])
  @@index([price_supplement])
  @@map("option_values")
}

model DeliveryZone {
  id        String  @id @default(uuid()) @db.Uuid
  name_fr   String  @db.VarChar(100)
  name_ar   String  @db.VarChar(100)
  fee_dzd   Decimal @db.Decimal(10, 2)
  is_active Boolean @default(true)
  orders    Order[]

  @@index([is_active])
  @@map("delivery_zones")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  order_number    String      @unique @db.VarChar(50)
  customer_name   String      @db.VarChar(150)
  customer_phone  String      @db.VarChar(30)
  type            OrderType   @default(DELIVERY)
  zone            DeliveryZone? @relation(fields: [zone_id], references: [id])
  zone_id         String?     @db.Uuid
  address_details String?     @db.Text
  status          OrderStatus @default(PENDING)
  total_amount    Decimal     @db.Decimal(10, 2)
  locale          Locale      @default(fr)
  created_at      DateTime    @default(now()) @db.Timestamptz(3)
  updated_at      DateTime    @updatedAt @db.Timestamptz(3)
  orderItems      OrderItem[]

  @@index([status])
  @@index([type])
  @@index([created_at])
  @@index([status, created_at])
  @@index([type, status])
  @@map("orders")
}

model OrderItem {
  id              String @id @default(uuid()) @db.Uuid
  order           Order  @relation(fields: [order_id], references: [id])
  order_id        String @db.Uuid
  product_snapshot Json
  quantity        Int
  unit_price      Decimal @db.Decimal(10, 2)
  total_price     Decimal @db.Decimal(10, 2)

  @@index([order_id])
  @@map("order_items")
}
